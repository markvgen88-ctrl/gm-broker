# ============================================================
# G.M. Broker — переменные окружения фронтенда (Vite)
# Скопируйте этот файл в .env (для локальной разработки) или
# задайте переменную на этапе сборки/деплоя.
# ============================================================

# Базовый URL backend-API.
# Локально можно оставить пустым — используется прокси Vite (см. vite.config.ts),
# который перенаправляет /api на http://localhost:4000.
# В продакшене укажите полный адрес вашего backend, например:
# VITE_API_BASE_URL=https://api.gmbroker.ru/api
VITE_API_BASE_URL=/api
