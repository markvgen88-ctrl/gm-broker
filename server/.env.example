# ============================================================
# G.M. Broker — переменные окружения backend-сервера
# Скопируйте этот файл в .env и заполните реальными значениями.
# Файл .env никогда не должен попадать в git / публичный доступ.
# ============================================================

# Порт, на котором запускается Express-сервер
PORT=4000

# Домен(ы) фронтенда, которым разрешено обращаться к API (через запятую).
# Для локальной разработки можно оставить "*".
CLIENT_ORIGIN=*

# ---------------- Telegram ----------------
# Токен бота, полученный у @BotFather в Telegram.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ID чата/канала, куда бот будет присылать заявки.
# Как получить свой chat_id:
#   1. Найдите вашего бота в Telegram и отправьте ему любое сообщение
#      (или добавьте бота в нужный чат/канал и напишите там что-нибудь).
#   2. Откройте в браузере:
#      https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
#   3. В ответе найдите блок "chat": { "id": ЧИСЛО, ... } — это и есть chat_id.
#      Для личных сообщений id обычно положительный, для групп — отрицательный.
TELEGRAM_CHAT_ID=123456789

# ---------------- Email (SMTP) ----------------
# Параметры вашего почтового сервера (например, Яндекс, Mail.ru, Gmail, corporate SMTP).
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=your-sender@mail.ru
SMTP_PASS=your-smtp-password-or-app-password

# Адрес отправителя (обычно совпадает с SMTP_USER)
MAIL_FROM=your-sender@mail.ru

# Адрес получателя заявок (брокер)
MAIL_TO=markvgen@bk.ru

# ---------------- Резервная копия заявок (Google Sheets) ----------------
# Необязательный, но настоятельно рекомендуемый третий канал доставки заявок.
# Если Telegram-бот или SMTP временно недоступны, заявка всё равно попадёт
# в Google-таблицу и не потеряется. Пошаговая настройка (5-10 минут,
# бесплатно, без БД) — см. server/GOOGLE_SHEETS_SETUP.md.

# URL Google Apps Script Web App (выдаётся при деплое скрипта, см. инструкцию).
GOOGLE_SHEETS_WEBHOOK_URL=

# Произвольная секретная строка — проверяется на стороне Apps Script,
# чтобы посторонние не могли слать в таблицу мусор, зная только URL.
GOOGLE_SHEETS_WEBHOOK_SECRET=

# ---------------- Мини-CRM (страница /admin на сайте) ----------------
# Пароль для входа в /admin — список всех заявок, смена статуса, заметки
# по клиенту. Придумайте длинный уникальный пароль (это не пароль от
# почты/Telegram, а отдельный секрет только для этой страницы).
# Заявки при этом сохраняются в локальный файл server/data/leads.db
# автоматически — ничего дополнительно настраивать не нужно.
ADMIN_PASSWORD=MgV89834448631

# Необязательно: свой путь к файлу базы данных (по умолчанию — server/data/leads.db).
# Полезно на хостингах с отдельным persistent-диском.
# DB_PATH=/var/data/leads.db

# В проде обязательно выставьте NODE_ENV=production — от этого зависит,
# как выставляется cookie сессии /admin (secure + sameSite=none).
NODE_ENV=production
